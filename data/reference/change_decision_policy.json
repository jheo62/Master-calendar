    "Estado_Provincia": "AUTO_ELIGIBLE",
    "Zona_Horaria_Arena": "AUTO_ELIGIBLE",
    "TV_Normalizada": "REVIEW_REQUIRED",
    "Streaming_Normalizado": "REVIEW_REQUIRED",
    "Estado": "REVIEW_REQUIRED",
    "URL_NBA": "REVIEW_REQUIRED",
    "Visitante": "BLOCKED",
    "Local": "BLOCKED",
    "Fase": "BLOCKED",
    "Grupo_NBA_Cup": "BLOCKED",
    "Evento_Especial": "BLOCKED",
    "Es_NBA_Cup": "BLOCKED",
    "Es_Partido_Especial": "BLOCKED",
